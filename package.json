{
  "name": "silphscope-pvp",
  "private": true,
  "version": "7.27.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000",
    "dev:lan": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "ingest": "node scripts/ingest-telemetry.mjs --prune-remote",
    "telemetry:sync": "node scripts/ingest-telemetry.mjs --sync-only --prune-remote",
    "telemetry:report": "node scripts/ingest-telemetry.mjs --prune-remote",
    "telemetry:reprocess": "node scripts/ingest-telemetry.mjs --reprocess-local",
    "telemetry:watch": "node scripts/ingest-telemetry.mjs --watch --sync-only --prune-remote",
    "telemetry:install-task": "powershell -ExecutionPolicy Bypass -File scripts/install-local-telemetry-task.ps1",
    "telemetry:uninstall-task": "powershell -ExecutionPolicy Bypass -File scripts/install-local-telemetry-task.ps1 -Uninstall"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
