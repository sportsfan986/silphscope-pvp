<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="#1e293b"
    android:paddingHorizontal="10dp"
    android:paddingVertical="10dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_preset_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Great League Team"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/text_preset_archetype_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABC"
                android:textColor="#38bdf8"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:background="#0f172a"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/text_preset_league"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GREAT LEAGUE"
                android:textColor="#38bdf8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:background="#0f172a"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_preset_metrics_and_sprites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/text_preset_metrics_badges"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lead BR: 512 (N)  •  Mach BR: 642 (Solid)  •  Swap BR: #2 518 / #3 496"
                android:textColor="#94a3b8"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/container_preset_team_sprites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_preset_single_meta_subline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94a3b8"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:layout_marginTop="1dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/container_preset_meta_pools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_preset_pokemon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clodsire (1494) • Feraligatr (1498) • Mandibuzz (1496)"
            android:textColor="#cbd5e1"
            android:textSize="11.5sp"
            android:layout_marginTop="3dp" />

        <LinearLayout
            android:id="@+id/layout_outer_preset_clone_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_clone_preset"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:text="📋 Clone"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:backgroundTint="#334155"
                android:textColor="#38bdf8"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/btn_copy_preset_mode"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:text="🏛️ → Show 6"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:backgroundTint="#334155"
                android:textColor="#fbbf24"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/btn_swap_preset_opp6"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:text="⇄ To Opp 6"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:backgroundTint="#334155"
                android:textColor="#fda4af"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="6dp">

        <RadioButton
            android:id="@+id/radio_selected"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:buttonTint="#38bdf8"
            android:contentDescription="Select Active Team" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_edit_preset"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:padding="3dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit Team &amp; Moves" />

        <Space
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="3" />

        <ImageButton
            android:id="@+id/btn_delete_preset"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:padding="3dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Preset" />

        <Space
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="3" />

        <TextView
            android:id="@+id/btn_move_preset_up"
            android:layout_width="32dp"
            android:layout_height="18dp"
            android:gravity="center"
            android:text="▲"
            android:textSize="10sp"
            android:textColor="#94a3b8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Move Preset Up" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/drag_handle_preset"
            android:layout_width="32dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:text="⋮⋮"
            android:textColor="#64748b"
            android:textSize="14sp"
            android:textStyle="bold"
            android:contentDescription="Hold and drag to rearrange team order" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_move_preset_down"
            android:layout_width="32dp"
            android:layout_height="18dp"
            android:gravity="center"
            android:text="▼"
            android:textSize="10sp"
            android:textColor="#94a3b8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Move Preset Down" />
    </LinearLayout>

</LinearLayout>
